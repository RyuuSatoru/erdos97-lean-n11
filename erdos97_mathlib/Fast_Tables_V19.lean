def decodedWitnesses (p : Nat) : Nat × Nat × Nat × Nat :=
  if p < 2310 then
    let v := witnessPacked >>> (16*p)
    (v%16,(v >>> 4)%16,(v >>> 8)%16,(v >>> 12)%16)
  else E97Packed18.decodedWitnesses p
theorem witness_scan : (List.range 2310).all (fun p =>
    decide (decodedWitnesses p = E97Packed18.decodedWitnesses p)) = true := by decide +kernel
theorem decodedWitnesses_eq (p : Nat) : decodedWitnesses p = E97A2Rows.decodedWitnesses p := by
  rw [← E97Packed18.decodedWitnesses_eq]
  by_cases hp : p < 2310
  · exact decide_eq_true_eq.mp ((List.all_eq_true.mp witness_scan) p (List.mem_range.mpr hp))
  · simp only [decodedWitnesses,hp,ite_false]

def fiveAt (i : Nat) : List Nat :=
  if i < 462 then
    let v := fivePacked >>> (20*i)
    [v%16,(v >>> 4)%16,(v >>> 8)%16,(v >>> 12)%16,(v >>> 16)%16]
  else []
theorem five_list_exact : (List.range 462).map fiveAt = E97FastLookup17.fives.toList := by decide +kernel
theorem fiveAt_eq (i : Nat) : fiveAt i = E97FastLookup17.fives[i]?.getD [] := by
  exact E97Packed18.lookup_from_list fiveAt E97FastLookup17.fives 462 [] five_list_exact
    (by intro j hj; simp only [fiveAt,Nat.not_lt.mpr hj,ite_false]) i

def rowMask (c k : Nat) : Nat :=
  if c < 11 ∧ k < 210 then (maskPacked >>> (11*(210*c+k)))%2048
  else E97FastLookup17.fastRowMask c k
theorem mask_scan (c : Nat) (hc : c < 11) :
    (List.range 210).all (fun k => decide (rowMask c k = E97FastLookup17.fastRowMask c k)) = true := by
  interval_cases c
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
theorem rowMask_eq (c k : Nat) : rowMask c k = E97AllowFinite.rowMask c k := by
  rw [← E97FastLookup17.fastRowMask_eq]
  by_cases h : c < 11 ∧ k < 210
  · exact decide_eq_true_eq.mp ((List.all_eq_true.mp (mask_scan c h.1)) k (List.mem_range.mpr h.2))
  · simp only [rowMask,h,ite_false]
def fastPatternAt (id : Nat) : A3Pattern := Id.run do
  let five := fiveAt (id / 10)
  let t := (id % 10) / 2
  let p := five.getD t 11
  let a := five.getD ((t + 1) % 5) 11
  let b := five.getD ((t + 2) % 5) 11
  let c := five.getD ((t + 3) % 5) 11
  let q := five.getD ((t + 4) % 5) 11
  if id % 2 = 0 then
    return ⟨b,c,(2 ^ p) ||| (2 ^ a),(2 ^ q) ||| (2 ^ a) ||| (2 ^ b)⟩
  else
    return ⟨a,b,(2 ^ p) ||| (2 ^ b) ||| (2 ^ c),(2 ^ q) ||| (2 ^ c)⟩
theorem fastPatternAt_eq (id : Nat) : fastPatternAt id = patternAt id := by
  simp only [fastPatternAt,fiveAt_eq,E97FastLookup17.array_lookup,E97FastLookup17.fives_exact,patternAt]

def fastCellData (slot : Nat) : Nat × Nat × Nat × Nat × Nat × Nat :=
  let i := slot / 44100
  let j := slot % 44100
  let (a,b) := E97FastLookup17.fastPairAt i
  let x := j / 210
  let y := j % 210
  (a,b,x,y,rowMask a x,rowMask b y)
theorem fastCellData_eq (slot : Nat) : fastCellData slot = cellData slot := by
  simp only [fastCellData,E97FastLookup17.fastPairAt_eq,rowMask_eq,cellData]
def fastCheckReason (slot code : Nat) : Bool :=
  if slot < 2425500 then
    if code = 0 then true
    else
      let (a, b, _x, _y, ma, mb) := fastCellData slot
      if code ≤ 55 then
        let (u, v) := E97FastLookup17.fastPairAt (code - 1)
        containsBits ma ((2 ^ u) ||| (2 ^ v)) &&
        containsBits mb ((2 ^ u) ||| (2 ^ v)) &&
        (alternate a b u v == false)
      else if code ≤ 4675 then
        let pat := fastPatternAt (code - 56)
        if pat.c = a ∧ pat.d = b then
          containsBits ma pat.mc && containsBits mb pat.md
        else if pat.c = b ∧ pat.d = a then
          containsBits mb pat.mc && containsBits ma pat.md
        else false
      else false
  else false

theorem fastCheckReason_eq (slot code : Nat) : fastCheckReason slot code = checkReason slot code := by
  simp only [fastCheckReason,fastCellData_eq,E97FastLookup17.fastPairAt_eq,fastPatternAt_eq,checkReason]

def fastCenterA (slot : Nat) : Nat := (E97FastLookup17.fastPairAt (slot / 44100)).1
def fastCenterB (slot : Nat) : Nat := (E97FastLookup17.fastPairAt (slot / 44100)).2
theorem fastCenterA_eq (slot : Nat) : fastCenterA slot = E97CellSlot.centerA slot := by
  simp only [fastCenterA,E97FastLookup17.fastPairAt_eq,E97CellSlot.centerA]
theorem fastCenterB_eq (slot : Nat) : fastCenterB slot = E97CellSlot.centerB slot := by
  simp only [fastCenterB,E97FastLookup17.fastPairAt_eq,E97CellSlot.centerB]

def fastCheckedPair (path : List Nat) (nextRow : Nat) (hint : E97PairGuard15.PairHint) : Bool :=
  decide (hint.slot < 2425500) &&
  decide (((210 * fastCenterA hint.slot + E97CellSlot.rowX hint.slot) ∈ path ∧
      nextRow = 210 * fastCenterB hint.slot + E97CellSlot.rowY hint.slot) ∨
    ((210 * fastCenterB hint.slot + E97CellSlot.rowY hint.slot) ∈ path ∧
      nextRow = 210 * fastCenterA hint.slot + E97CellSlot.rowX hint.slot)) &&
  decide ((if fastCheckReason hint.slot hint.code then hint.code else 0) ≠ 0)
theorem fastCheckedPair_eq (path : List Nat) (r : Nat) (h : E97PairGuard15.PairHint) :
    fastCheckedPair path r h = E97PairGuard15.checkedPair path r h := by
  simp only [fastCheckedPair,fastCenterA_eq,fastCenterB_eq,fastCheckReason_eq,
    E97PairGuard15.checkedPair,E97Guarded.guardedReasonAt]
