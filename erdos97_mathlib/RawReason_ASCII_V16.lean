def pairs : Array (Array String) := #[pair00,pair01,pair02,pair03,pair04,pair05,pair06,pair07,pair08,pair09,pair10,pair11,pair12,pair13,pair14,pair15,pair16,pair17,pair18,pair19,pair20,pair21,pair22,pair23,pair24,pair25,pair26,pair27,pair28,pair29,pair30,pair31,pair32,pair33,pair34,pair35,pair36,pair37,pair38,pair39,pair40,pair41,pair42,pair43,pair44,pair45,pair46,pair47,pair48,pair49,pair50,pair51,pair52,pair53,pair54]
def reasonAt (slot : Nat) : Nat :=
  let bytes := ((pairs[slot/44100]!)[(slot%44100)/210]!).toUTF8
  let offset := 2*(slot%210)
  ((bytes[offset]!).toNat - 33) * 85 + ((bytes[offset+1]!).toNat - 33)
