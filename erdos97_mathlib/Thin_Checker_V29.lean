def a2FromPairs (path : List Nat) (r : Nat) (pairs : List (Nat × Nat)) : Option A2Hint :=
  match pairs with
  | [] => none
  | (u,v) :: rest =>
    let hits := path.filter (fun p => u ∈ rowWitnessSet p ∧
      v ∈ rowWitnessSet p)
    match hits with
    | a :: b :: _ => some ⟨a,b,r,u,v⟩
    | _ => a2FromPairs path r rest

def suggestedHints (rawReasonAt : Nat → Nat) : HintProvider :=
  fun path r => ⟨a2FromPairs path r (witnessPairs r), T29E97HintSearch16.pairSuggestion rawReasonAt path r⟩

def guardedAllows (path : List Nat) (r : Nat) (hints : CandidateHints) : Bool :=
  (match hints.pair with
    | none => true
    | some h => !(T29E97FastTables19.fastCheckedPair path r h)) &&
    T29E97FastChecker19.guardedA2Allows (path ++ [r]) hints.a2

def candidateRows (hints : HintProvider) (path : List Nat) (center : Nat) : List Nat :=
  ((List.range 210).map (fun k => 210*center+k)).filter
    (fun r => guardedAllows path r (hints path r))

end T29E97FastChecker19


namespace T29E97Sparse20
def insertEdge (x : Nat) : List Nat → List Nat
  | [] => [x]
  | y :: ys => if x ≤ y then x :: y :: ys else y :: insertEdge x ys

def sortEdges : List Nat → List Nat
  | [] => []
  | x :: xs => insertEdge x (sortEdges xs)

end T29E97Sparse20

namespace T29E97EdgeWalk22
abbrev Receipt := Nat × List (Nat × Nat)

def rowContains (r e : Nat) : Bool :=
  let (a,b,c,d) := T29E97Packed18.rowAt r
  decide (e = a ∨ e = b ∨ e = c ∨ e = d)

def checkWalk (path : List Nat) (start finish : Nat) : List (Nat × Nat) → Bool
  | [] => decide (start = finish)
  | (row,next) :: rest =>
    decide (row ∈ path) && rowContains row start && rowContains row next &&
      checkWalk path next finish rest

def checkPairings (path : List Nat) : List Nat → List Receipt → Bool
  | [],[] => true
  | e :: es,(f,steps) :: rest =>
    checkWalk path e f steps && checkPairings path es rest
  | _,_ => false

def positiveEdges : List (Nat × Nat) → List Nat
  | [] => []
  | (q,w) :: rest =>
    let (a,b,_,_) := T29E97Packed18.quadAt q
    List.replicate w a ++ List.replicate w b ++ positiveEdges rest

def negativeEdges : List (Nat × Nat) → List Nat
  | [] => []
  | (q,w) :: rest =>
    let (_,_,c,d) := T29E97Packed18.quadAt q
    List.replicate w c ++ List.replicate w d ++ negativeEdges rest

def checkedFlow (path : List Nat) (ts : List (Nat × Nat)) (receipts : List Receipt) : Bool :=
  (!ts.isEmpty) &&
  ts.all (fun qw => decide (qw.1 < 660 ∧ 0 < qw.2 ∧ qw.2 ≤ 1000000)) &&
  checkPairings path (positiveEdges ts) receipts &&
  decide (T29E97Sparse20.sortEdges (receipts.map Prod.fst) = T29E97Sparse20.sortEdges (negativeEdges ts))

end T29E97EdgeWalk22

namespace T29E97WalkChecker22
open T29E97TypedChecker15
inductive Certificate where
  | flow (terms : List (Nat × Nat)) (receipts : List T29E97EdgeWalk22.Receipt)
  | empty (center : Nat)
  | branch (center : Nat) (children : List (Nat × Certificate))

abbrev candidateRows := T29E97FastChecker19.candidateRows

abbrev suggestedHints := T29E97FastChecker19.suggestedHints

def checkTree (fuel : Nat) (hints : HintProvider) (path : List Nat)
    (cert : Certificate) : Bool :=
  match fuel with
  | 0 => false
  | n+1 => match cert with
    | .flow terms receipts => T29E97EdgeWalk22.checkedFlow path terms receipts
    | .empty c => decide (c < 11) && decide (candidateRows hints path c = [])
    | .branch c children => decide (c < 11) &&
        decide (children.map Prod.fst = candidateRows hints path c) &&
        children.all (fun child => checkTree n hints (path ++ [child.1]) child.2)

end T29E97WalkChecker22

namespace T29E97FastHint25
open T29E97TypedChecker15 T29E97A2Guard14
def rowMask (r : Nat) : Nat :=
  if r < 2310 then (T29E97FastTables19.maskPacked >>> (11*r))%2048 else 0

def prefixPairs : List (Nat × Nat) → List (Nat × Nat × Nat)
  | [] => []
  | (p,pm) :: rest =>
    (rest.map (fun rm => (p,rm.1,pm &&& rm.2))) ++ prefixPairs rest

def findA2 (r rm : Nat) : List (Nat × Nat × Nat) → Option A2Hint
  | [] => none
  | (p,q,common) :: rest =>
    let shared := common &&& rm
    if p/210 ≠ q/210 ∧ p/210 ≠ r/210 ∧ q/210 ≠ r/210 ∧
        (shared &&& (shared-1)) ≠ 0 then
      match (List.range 11).filter (fun u => (shared &&& (2^u)) != 0) with
      | u :: v :: _ => some ⟨p,q,r,u,v⟩
      | _ => findA2 r rm rest
    else findA2 r rm rest

def suggestedHints (rawReasonAt : Nat → Nat) : HintProvider :=
  fun path =>
    let pairs := prefixPairs (path.map (fun p => (p,rowMask p)))
    fun r => ⟨findA2 r (rowMask r) pairs,T29E97HintSearch16.pairSuggestion rawReasonAt path r⟩

end T29E97FastHint25

