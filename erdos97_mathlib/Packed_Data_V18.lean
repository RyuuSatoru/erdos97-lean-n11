import Fast_TypedChecker_V17
set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace E97Packed18
def rowPacked : Nat := 
def rowAt (i : Nat) : E97Flow.Edge4 :=
  if i < 2310 then
    let v := rowPacked >>> (24*i)
    (v % 64,(v >>> 6) % 64,(v >>> 12) % 64,(v >>> 18) % 64)
  else (0,0,0,0)
theorem row_list_exact :
    (List.range 2310).map rowAt = E97Flow.rowSpokeTable.toList := by decide +kernel
def quadPacked : Nat := 
def quadAt (i : Nat) : E97Flow.Edge4 :=
  if i < 660 then
    let v := quadPacked >>> (24*i)
    (v % 64,(v >>> 6) % 64,(v >>> 12) % 64,(v >>> 18) % 64)
  else (0,0,0,0)
theorem quad_list_exact :
    (List.range 660).map quadAt = E97Flow.quadTable.toList := by decide +kernel

theorem lookup_from_list {α : Type} (f : Nat → α) (xs : Array α) (n : Nat) (d : α)
    (hlist : (List.range n).map f = xs.toList)
    (hout : ∀ i, n ≤ i → f i = d) (i : Nat) :
    f i = xs[i]?.getD d := by
  have h := congrArg (fun l : List α => l[i]?.getD d) hlist
  by_cases hi : i < n
  · simpa [List.getElem?_range,hi] using h
  · rw [hout i (by omega)]
    simpa [List.getElem?_range,hi] using h

theorem rowAt_eq (i : Nat) : rowAt i = E97Flow.getRow i := by
  exact lookup_from_list rowAt E97Flow.rowSpokeTable 2310 (0,0,0,0)
    row_list_exact (by intro j hj; simp only [rowAt,Nat.not_lt.mpr hj,ite_false]) i
theorem quadAt_eq (i : Nat) : quadAt i = E97Flow.getQuad i := by
  exact lookup_from_list quadAt E97Flow.quadTable 660 (0,0,0,0)
    quad_list_exact (by intro j hj; simp only [quadAt,Nat.not_lt.mpr hj,ite_false]) i

def decodedWitnesses (p : Nat) : Nat × Nat × Nat × Nat :=
  let center := p / 210
  let (e0,e1,e2,e3) := rowAt p
  (E97A2Rows.otherEndpoint center e0,E97A2Rows.otherEndpoint center e1,
    E97A2Rows.otherEndpoint center e2,E97A2Rows.otherEndpoint center e3)
theorem decodedWitnesses_eq (p : Nat) : decodedWitnesses p = E97A2Rows.decodedWitnesses p := by
  simp only [decodedWitnesses,rowAt_eq,E97A2Rows.decodedWitnesses]

def addActualRow (classes : Array Nat) (rowId : Nat) : Array Nat :=
  let (a,b,c,d) := rowAt rowId
  E97TreeKF4.mergeClasses (E97TreeKF4.mergeClasses (E97TreeKF4.mergeClasses classes a b) a c) a d
theorem addActualRow_eq (cs : Array Nat) (p : Nat) :
    addActualRow cs p = E97TreeKF4.addActualRow cs p := by
  simp only [addActualRow,rowAt_eq,E97TreeKF4.addActualRow]

def classesOfRows (path : List Nat) : Array Nat :=
  path.foldl (fun cs p => addActualRow cs p) E97TreeKF4.emptyClasses
theorem classesOfRows_eq (path : List Nat) :
    classesOfRows path = E97ClassInvariant13.classesOfRows path := by
  simp only [classesOfRows,addActualRow_eq,E97ClassInvariant13.classesOfRows]

def reducedCoeff (classes : Array Nat) (q representative : Nat) : Int :=
  let (a,b,c,d) := quadAt q
  (if (classes[a]?).getD a == representative then (1 : Int) else 0) +
  (if (classes[b]?).getD b == representative then (1 : Int) else 0) -
  (if (classes[c]?).getD c == representative then (1 : Int) else 0) -
  (if (classes[d]?).getD d == representative then (1 : Int) else 0)
theorem reducedCoeff_eq (cs : Array Nat) (q e : Nat) :
    reducedCoeff cs q e = E97TreeKF4.reducedCoeff cs q e := by
  simp only [reducedCoeff,quadAt_eq,E97TreeKF4.reducedCoeff]

def checkedK0 (classes : Array Nat) (q : Nat) : Bool :=
  decide (q < 660) &&
  (List.range 55).all (fun e => decide (reducedCoeff classes q e = 0))
def checkedF (classes : Array Nat) (terms : List (Nat × Nat)) : Bool :=
  (!terms.isEmpty) &&
  terms.all (fun qw => decide (qw.1 < 660 ∧ 0 < qw.2 ∧ qw.2 ≤ 1000000)) &&
  (List.range 55).all (fun e => decide
    ((terms.foldl (fun acc qw => acc + (Int.ofNat qw.2) *
      reducedCoeff classes qw.1 e) (0 : Int)) = 0))
theorem checkedK0_eq (cs : Array Nat) (q : Nat) : checkedK0 cs q = E97TreeKF4.checkedK0 cs q := by
  simp only [checkedK0,reducedCoeff_eq,E97TreeKF4.checkedK0]
theorem checkedF_eq (cs : Array Nat) (t : List (Nat × Nat)) : checkedF cs t = E97TreeKF4.checkedF cs t := by
  simp only [checkedF,reducedCoeff_eq,E97TreeKF4.checkedF]
