def rows (c : Nat) : Array (List Nat) :=
  match c with
  | 0 => rows00
  | 1 => rows01
  | 2 => rows02
  | 3 => rows03
  | 4 => rows04
  | 5 => rows05
  | 6 => rows06
  | 7 => rows07
  | 8 => rows08
  | 9 => rows09
  | 10 => rows10
  | _ => #[]
theorem pairs_exact : pairs.toList = chooseK 2 (List.range 11) := by decide +kernel
theorem fives_exact : fives.toList = chooseK 5 (List.range 11) := by decide +kernel
theorem rows_exact (c : Nat) (hc : c < 11) :
    (rows c).toList = chooseK 4 ((List.range 11).filter (fun v => v != c)) := by
  interval_cases c
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel
  · decide +kernel

theorem array_lookup {α : Type} (a : Array α) (i : Nat) (d : α) :
    a[i]?.getD d = a.toList.getD i d := by
  rw [← Array.getElem?_toList]
  rfl

def fastPairAt (i : Nat) : Nat × Nat :=
  let pair := pairs[i]?.getD []
  (pair.getD 0 11, pair.getD 1 11)
theorem fastPairAt_eq (i : Nat) : fastPairAt i = pairAt i := by
  simp only [fastPairAt, array_lookup, pairs_exact, pairAt]

def fastWitnessFour (c k : Nat) : List Nat :=
  if c < 11 then (rows c)[k]?.getD [] else witnessFour c k
theorem fastWitnessFour_eq (c k : Nat) : fastWitnessFour c k = witnessFour c k := by
  unfold fastWitnessFour
  split
  · rename_i hc
    rw [array_lookup, rows_exact c hc]
    rfl
  · rfl

def fastRowMask (c k : Nat) : Nat :=
  (fastWitnessFour c k).foldl (fun acc v => acc ||| (2 ^ v)) 0
theorem fastRowMask_eq (c k : Nat) : fastRowMask c k = rowMask c k := by
  simp only [fastRowMask,fastWitnessFour_eq,rowMask]

def fastPatternAt (id : Nat) : A3Pattern := Id.run do
  let five := fives[id / 10]?.getD []
  let t := (id % 10) / 2
  let p := five.getD t 11
  let a := five.getD ((t + 1) % 5) 11
  let b := five.getD ((t + 2) % 5) 11
  let c := five.getD ((t + 3) % 5) 11
  let q := five.getD ((t + 4) % 5) 11
  if id % 2 = 0 then
    return ⟨b,c,(2 ^ p) ||| (2 ^ a),(2 ^ q) ||| (2 ^ a) ||| (2 ^ b)⟩
  else
    return ⟨a,b,(2 ^ p) ||| (2 ^ b) ||| (2 ^ c),(2 ^ q) ||| (2 ^ c)⟩
theorem fastPatternAt_eq (id : Nat) : fastPatternAt id = patternAt id := by
  simp only [fastPatternAt, array_lookup, fives_exact, patternAt]

def fastCellData (slot : Nat) : Nat × Nat × Nat × Nat × Nat × Nat :=
  let i := slot / 44100
  let j := slot % 44100
  let (a,b) := fastPairAt i
  let x := j / 210
  let y := j % 210
  (a,b,x,y,fastRowMask a x,fastRowMask b y)
theorem fastCellData_eq (slot : Nat) : fastCellData slot = cellData slot := by
  simp only [fastCellData,fastPairAt_eq,fastRowMask_eq,cellData]
def fastCheckReason (slot code : Nat) : Bool :=
  if slot < 2425500 then
    if code = 0 then true
    else
      let (a, b, _x, _y, ma, mb) := fastCellData slot
      if code ≤ 55 then
        let (u, v) := fastPairAt (code - 1)
        containsBits ma ((2 ^ u) ||| (2 ^ v)) &&
        containsBits mb ((2 ^ u) ||| (2 ^ v)) &&
        (alternate a b u v == false)
      else if code ≤ 4675 then
        let pat := fastPatternAt (code - 56)
        if pat.c = a ∧ pat.d = b then
          containsBits ma pat.mc && containsBits mb pat.md
        else if pat.c = b ∧ pat.d = a then
          containsBits mb pat.mc && containsBits ma pat.md
        else false
      else false
  else false

theorem fastCheckReason_eq (slot code : Nat) : fastCheckReason slot code = checkReason slot code := by
  simp only [fastCheckReason,fastCellData_eq,fastPairAt_eq,fastPatternAt_eq,checkReason]

def fastCenterA (slot : Nat) : Nat := (fastPairAt (slot / 44100)).1
def fastCenterB (slot : Nat) : Nat := (fastPairAt (slot / 44100)).2
theorem fastCenterA_eq (slot : Nat) : fastCenterA slot = E97CellSlot.centerA slot := by
  simp only [fastCenterA,fastPairAt_eq,E97CellSlot.centerA]
theorem fastCenterB_eq (slot : Nat) : fastCenterB slot = E97CellSlot.centerB slot := by
  simp only [fastCenterB,fastPairAt_eq,E97CellSlot.centerB]

def fastCheckedPair (path : List Nat) (nextRow : Nat) (hint : E97PairGuard15.PairHint) : Bool :=
  decide (hint.slot < 2425500) &&
  decide (((210 * fastCenterA hint.slot + E97CellSlot.rowX hint.slot) ∈ path ∧
      nextRow = 210 * fastCenterB hint.slot + E97CellSlot.rowY hint.slot) ∨
    ((210 * fastCenterB hint.slot + E97CellSlot.rowY hint.slot) ∈ path ∧
      nextRow = 210 * fastCenterA hint.slot + E97CellSlot.rowX hint.slot)) &&
  decide ((if fastCheckReason hint.slot hint.code then hint.code else 0) ≠ 0)
theorem fastCheckedPair_eq (path : List Nat) (r : Nat) (h : E97PairGuard15.PairHint) :
    fastCheckedPair path r h = E97PairGuard15.checkedPair path r h := by
  simp only [fastCheckedPair,fastCenterA_eq,fastCenterB_eq,fastCheckReason_eq,
    E97PairGuard15.checkedPair,E97Guarded.guardedReasonAt]
