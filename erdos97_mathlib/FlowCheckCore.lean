def getQuad (i : Nat) : Edge4 := (quadTable[i]?).getD (0,0,0,0)
def getRow (i : Nat) : Edge4 := (rowSpokeTable[i]?).getD (0,0,0,0)

def delta (u v e : Nat) : Int :=
  (if u == e then 1 else 0) - (if v == e then 1 else 0)

def quadCoeff (q e : Nat) : Int :=
  let (a,b,c,d) := getQuad q
  delta a c e + delta b d e

def sourced (path : List Nat) (u v : Nat) : Bool :=
  path.any (fun p =>
    let (a,b,c,d) := getRow p
    (u == a) && ((v == b) || (v == c) || (v == d)))

def validFlow (path : List Nat)
    (weighted : List WeightedQuad) (eqs : List EqWitness) : Bool :=
  (! weighted.isEmpty) &&
  path.all (fun p => decide (p < 2310)) &&
  weighted.all (fun qw => decide (qw.1 < 660) && decide (qw.2 > 0)) &&
  eqs.all (fun x => let (u,v,lam) := x
    decide (u < 55) && decide (v < 55) && lam != 0 && sourced path u v) &&
  (List.range 55).all (fun e =>
    (weighted.foldl (fun acc qw =>
      acc + (Int.ofNat qw.2) * quadCoeff qw.1 e) (0 : Int)) ==
    (eqs.foldl (fun acc x =>
      let (u,v,lam) := x
      acc + lam * delta u v e) (0 : Int)))

end E97Flow
